# ── Base de Datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# ── JWT (propio de TI — no tiene que coincidir con el de API_QUBIRA) ──────────
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# ── Cloudinary (almacenamiento de archivos en la nube) ────────────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ── Cuenta central de Qubira — acá se validan los logins ──────────────────────
CENTRAL_API_URL=https://api-qubira.onrender.com

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
